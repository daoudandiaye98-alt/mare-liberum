{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node tools/build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/mare.mjs": {
      "includeFiles": "data/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/mare?__p=/"
    },
    {
      "source": "/((?!api/).+)",
      "destination": "/api/mare?__p=/$1"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "atlas-data": false
    }
  }
}
