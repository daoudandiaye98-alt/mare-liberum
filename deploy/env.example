# /etc/mare/env · what the node on its own server is told. The bootstrap writes this file; nothing in it is in the repository.
MARE_BASE=https://mareliberum.dev
HOST=127.0.0.1
PORT=8787
MARE_PROXY=1
MARE_STATE=/var/lib/mare
# made on the server by the bootstrap (openssl rand -hex 32) and never sent anywhere but to the sea's own database,
# which stores only its SHA-256:
# MARE_DB_SECRET=...
# handed to the server by the database once it knows that secret (deploy/README.md, "the long memory"):
# MARE_DB_URL=https://<project>.supabase.co
# MARE_DB_KEY=...
# the till and via (3.27.0), all optional:
# MARE_PAY_TO=0x...                 the wallet on Base the paid move is paid to (default: Angel's receiving wallet)
# MARE_ROUTE_PRICE_CENTS=2          the price of the paid move in US cents, 1 to 5
# MARE_X402_FACILITATOR=https://... the x402 facilitator that checks and settles payments (default: PayAI; "off": none,
#                                   every sale is then written down as unverified)
# MARE_VIA_SECRET=...               the key of the /via/ addresses (default: derived from MARE_DB_SECRET, so addresses
#                                   survive restarts; change it and every via address handed out before stops working)
