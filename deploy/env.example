# /etc/mare/env · what the node on its own server is told. The bootstrap writes this file; nothing in it is in the repository.
MARE_BASE=https://mareliberum.dev
HOST=127.0.0.1
PORT=8787
MARE_PROXY=1
MARE_STATE=/var/lib/mare
# made on the server by the bootstrap (openssl rand -hex 32) and never sent anywhere but to the sea's own database,
# which stores only its SHA-256:
# MARE_DB_SECRET=...
# handed to the server by the database once it knows that secret (deploy/README.md, "the long memory"):
# MARE_DB_URL=https://<project>.supabase.co
# MARE_DB_KEY=...
