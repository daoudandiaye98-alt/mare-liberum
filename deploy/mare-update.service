[Unit]
Description=Mare Liberum · fetch the newest build of the sea and run it
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mare-update
# a build of the sea reads some twenty thousand stores first-hand: half an hour on a small machine, more when the web is slow
TimeoutStartSec=3h
