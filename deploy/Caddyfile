# Mare Liberum · the web server in front of the node
# TLS certificates are fetched the first time a name is asked for, and only for the names listed below.
{
	on_demand_tls {
		ask http://127.0.0.1:8788/
	}
}

# the names this server may hold a certificate for (asked by the server itself, from this machine only)
http://127.0.0.1:8788 {
	bind 127.0.0.1
	@ours query domain=mareliberum.dev domain=www.mareliberum.dev domain=hz.mareliberum.dev
	handle @ours {
		respond 200
	}
	handle {
		respond 403
	}
}

(sea) {
	encode zstd gzip
	# a caller that came by https once keeps coming by https (the node before said the same)
	header Strict-Transport-Security "max-age=63072000"
	# what a browser is told about every answer of the sea: take the type as it is sent, show the sea in no frame of
	# another site, tell other sites the sea's name and never the path, run no plug-ins
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
	}
	# a request carries at most a megabyte (the node says the same)
	request_body {
		max_size 1MB
	}
	# files that travel beside the node (fonts, icons, the keys of the search engines) are served as they are
	root * /srv/mare/current/public
	@file {
		file
		not path */
	}
	handle @file {
		header Cache-Control "public, max-age=86400"
		header Access-Control-Allow-Origin "*"
		file_server
	}
	# everything else is the node; while it restarts, callers wait a moment instead of getting an error
	handle {
		reverse_proxy 127.0.0.1:8787 {
			lb_try_duration 25s
			lb_try_interval 300ms
			flush_interval -1
		}
	}
}

mareliberum.dev {
	tls {
		on_demand
	}
	import sea
}

# the same node under its working name: how the server is doing, and the sea before the main name points here
hz.mareliberum.dev {
	tls {
		on_demand
	}
	# the working name is not for the search engines
	@working not path /_forwarded /_forwarded/*
	header @working X-Robots-Tag "noindex, nofollow"
	# a caller that still reaches the host the sea lived on before (an old address in its memory, a connection it
	# never closed) is passed on to this server under /_forwarded, and gets the same answer as at the sea's own name
	@forwarded path /_forwarded/*
	@forwardedRoot path /_forwarded
	rewrite @forwardedRoot /
	uri @forwarded strip_prefix /_forwarded
	handle /_boot/* {
		uri strip_prefix /_boot
		root * /srv/mare/boot
		header Cache-Control "no-store"
		file_server
	}
	import sea
}

www.mareliberum.dev {
	tls {
		on_demand
	}
	redir https://mareliberum.dev{uri} 308
}

# by address, before any name points here: how the server is doing, nothing else
:80 {
	handle /_boot/* {
		uri strip_prefix /_boot
		root * /srv/mare/boot
		header Cache-Control "no-store"
		file_server
	}
	handle {
		respond "Mare Liberum · https://mareliberum.dev" 200
	}
}
