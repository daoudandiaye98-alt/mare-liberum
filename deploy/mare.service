[Unit]
Description=Mare Liberum · the open sea for agents
After=network-online.target
Wants=network-online.target

[Service]
User=mare
Group=mare
WorkingDirectory=/srv/mare/current
EnvironmentFile=/etc/mare/env
ExecStart=/usr/bin/env node --max-old-space-size=2048 serve.mjs
Restart=always
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryMax=3300M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mare

[Install]
WantedBy=multi-user.target
